[Unit]
Description=Lazik: sterowanie (strona z podgladem kamery i trybami jazdy, port 8000)
After=network-online.target
Wants=network-online.target

[Service]
User=rpi
WorkingDirectory=/home/rpi/lazik/sterowanie
ExecStart=/usr/bin/python3 /home/rpi/lazik/sterowanie/lazik_serwer.py
Environment=QT_QPA_PLATFORM=offscreen
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
